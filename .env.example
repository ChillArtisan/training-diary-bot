# the only required value: token from @BotFather
BOT_TOKEN=

# optional: pin the owner and the channel. When set they win over what the bot stored in its database.
# Leave empty to pair by chat: the bot logs a pair code at startup (docker compose logs), send /start CODE to it,
# then forward any channel post to it.
OWNER_ID=
CHANNEL_ID=

# optional: timezone of the owner (IANA name), default Europe/Moscow
DIARY_TZ=

# optional: http:// or socks5:// proxy for networks where Telegram is blocked
PROXY_URL=
